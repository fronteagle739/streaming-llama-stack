{
  "mcpServers": {
    "slstack": {
      "command": "python",
      "args": [
        "-B",
        "-m",
        "slstack",
        "--config",
        "<checkout>/my.local.json",
        "mcp"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "<checkout>"
      }
    }
  }
}
