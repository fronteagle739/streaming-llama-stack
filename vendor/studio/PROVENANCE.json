  "license": "MIT for Front Eagle code; third-party licenses remain authoritative",
  "local_patches": [
    {
      "path": "dsv41_session_process.py",
      "purpose": "Reuse the shared suspended Job and RAM watcher for HTTP-native startup and positive owner epochs; preserve the original constructor exception, incomplete cleanup certificate and strong owner reference if shutdown fails; progress-based operation liveness (stall_seconds: pipe bytes, diagnostics, job-tree CPU/I/O growth extend an operation, so no fixed wall-clock limit cuts off a 262K-token prefill or a long decode). No engine arithmetic changes."
    },
    {
      "path": "dsv41_session_contract.py, dsv41_session_process.py",
      "purpose": "rtxmac-producer-2: maximum_decode_tokens is the accepted decode-delta maximum (49152 = one whole local append in one apply_decode_delta); the producer handshake must advertise exactly 49152. MAX_DECODE (128) stays the normal chunk; a delta above it may declare up to 64 MiB + 6404 bytes per token. No engine arithmetic changes; hash checks unchanged."
    },
    {
      "path": "dsv41_session_contract.py, dsv41_session_process.py",
      "purpose": "rtxmac-producer-2b: negotiate instead of lockstep. Readiness accepts any maximum_decode_tokens >= 128; negotiate_decode_delta = min(peer maximum_decode_delta_tokens, else maximum_decode_tokens, else 128; MAX_DECODE_DELTA). The effective value is published to the peer in the broker metadata and enforced in begin_decode. No engine arithmetic changes."
    },
    {
      "path": "config.py, settings_store.py, dsv41_windows_runner.py",
      "purpose": "Portable storage/GPU defaults and capability-based device admission; exported code differs from source digests recorded for provenance."
    },
    {
      "path": "settings_store.py",
      "purpose": "Derive the default archive folder from the configured models folder rather than probing a developer drive; explicit settings and environment overrides retain precedence."
    },
    {
      "path": "dsv41_session_contract.py, dsv41_session_process.py, custom_models.py",
      "purpose": "Stack live sampling, streamed local KV/YOCO checkpoints, explicit version1 YOCO remote negotiation, and configurable Comfy model-root discovery. Original native state geometry and all-owner hash verification retained."
    },
    {
      "path": "adapter.py",
      "purpose": "Stack-owned media calls mark external adapters explicit-only: suppress automatic Krea, H3 profile and Bernini distillation LoRAs. Each invocation passes only requested adapter paths/weights and unloads its owned worker afterward."
    }
  ],
